<sdf version='1.10'>
  <model name='phoenixdrone_alpha'>
    <link name='base_link'>
      <pose>0 0 0.2 0 -0 0</pose>
      <inertial>
        <pose>0 0 0.157 0 -0 0</pose>
        <mass>0.675</mass>
        <inertia>
          <ixx>0.0115</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.0030</iyy>
          <iyz>0</iyz>
          <izz>0.0095</izz>
        </inertia>
      </inertial>
      <collision name='base_link_collision'>
        <pose>0 0 0 0 -0 0</pose>
        <geometry>
          <box>
            <size>0.2 0.6 0.06</size>
          </box>
        </geometry>
        <surface>
          <contact>
            <ode>
              <max_vel>10</max_vel>
              <min_depth>0.01</min_depth>
            </ode>
          </contact>
          <friction>
            <ode/>
          </friction>
        </surface>
      </collision>
      <visual name='base_link_visual'>
        <pose>0 0 0.27 0 -1.57075 0</pose>
        <geometry>
          <mesh>
            <scale>0.0006 0.0007 0.0007</scale>
            <uri>model://phoenixdrone/meshes/pacflyer_s100_mockup.dae</uri>
          </mesh>
        </geometry>
      </visual>
      <gravity>1</gravity>
      <velocity_decay/>
      <self_collide>0</self_collide>
      <!-- PX4 v1.16 gz_bridge uses fixed base_link sensor topic paths. -->
      <sensor name="imu_sensor" type="imu">
        <pose>0 0 0.157 0 0 0</pose>
        <always_on>1</always_on>
        <update_rate>500</update_rate>
        <imu>
          <angular_velocity>
            <x><noise type="gaussian"><stddev>0.0003394</stddev><dynamic_bias_stddev>3.8785e-05</dynamic_bias_stddev><dynamic_bias_correlation_time>1000</dynamic_bias_correlation_time></noise></x>
            <y><noise type="gaussian"><stddev>0.0003394</stddev><dynamic_bias_stddev>3.8785e-05</dynamic_bias_stddev><dynamic_bias_correlation_time>1000</dynamic_bias_correlation_time></noise></y>
            <z><noise type="gaussian"><stddev>0.0003394</stddev><dynamic_bias_stddev>3.8785e-05</dynamic_bias_stddev><dynamic_bias_correlation_time>1000</dynamic_bias_correlation_time></noise></z>
          </angular_velocity>
          <linear_acceleration>
            <x><noise type="gaussian"><stddev>0.004</stddev><dynamic_bias_stddev>0.006</dynamic_bias_stddev><dynamic_bias_correlation_time>300</dynamic_bias_correlation_time></noise></x>
            <y><noise type="gaussian"><stddev>0.004</stddev><dynamic_bias_stddev>0.006</dynamic_bias_stddev><dynamic_bias_correlation_time>300</dynamic_bias_correlation_time></noise></y>
            <z><noise type="gaussian"><stddev>0.004</stddev><dynamic_bias_stddev>0.006</dynamic_bias_stddev><dynamic_bias_correlation_time>300</dynamic_bias_correlation_time></noise></z>
          </linear_acceleration>
        </imu>
      </sensor>
      <sensor name="air_pressure_sensor" type="air_pressure">
        <always_on>1</always_on>
        <update_rate>50</update_rate>
        <air_pressure>
          <pressure>
            <!-- Match the PX4 Gazebo reference models and prevent a perfectly
                 static simulated pressure value from being rejected as stale. -->
            <noise type="gaussian">
              <mean>0</mean>
              <stddev>0.01</stddev>
            </noise>
          </pressure>
        </air_pressure>
      </sensor>
      <sensor name="magnetometer_sensor" type="magnetometer">
        <always_on>1</always_on>
        <update_rate>100</update_rate>
        <magnetometer>
          <!-- Noise is expressed in tesla by Gazebo.  This is the value used
               by PX4's Harmonic reference vehicle models. -->
          <x><noise type="gaussian"><stddev>0.0001</stddev></noise></x>
          <y><noise type="gaussian"><stddev>0.0001</stddev></noise></y>
          <z><noise type="gaussian"><stddev>0.0001</stddev></noise></z>
        </magnetometer>
      </sensor>
      <sensor name="navsat_sensor" type="navsat"><always_on>1</always_on><update_rate>30</update_rate></sensor>
    </link>
    <link name='phoenixdrone/imu_link'>
      <pose>0 0 0.357 0 -0 0</pose>
      <inertial>
        <pose>0 0 0 0 -0 0</pose>
        <mass>0.015</mass>
        <inertia>
          <ixx>1e-05</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>1e-05</iyy>
          <iyz>0</iyz>
          <izz>1e-05</izz>
        </inertia>
      </inertial>
      <!-- Sensors live on base_link because PX4's gz_bridge subscribes to
           fixed base_link topic paths.  Keeping a second set here only adds
           simulation load and produces unused duplicate sensor streams. -->
    </link>
    <joint name='phoenixdrone/imu_joint' type='fixed'>
      <child>phoenixdrone/imu_link</child>
      <parent>base_link</parent>
    </joint>
    <!-- Harmonic replacement for the original measairspeedsim module. -->
    <include merge="true">
      <uri>model://airspeed</uri>
      <pose>0 0 0.55 0 -1.57079632679 0</pose>
    </include>
    <joint name='airspeed_joint' type='fixed'>
      <parent>base_link</parent>
      <child>airspeed_link</child>
    </joint>
    <link name='rotor_left'>
      <pose>0.0 -0.195 0.4685 0 -0 0</pose>
      <inertial>
        <pose>0 0 0 0 -0 0</pose>
        <mass>0.005</mass>
        <inertia>
          <ixx>9.75e-07</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.000166704</iyy>
          <iyz>0</iyz>
          <izz>0.000167604</izz>
        </inertia>
      </inertial>
      <collision name='rotor_left_collision'>
        <pose>0 0 0 0 -0 0</pose>
        <geometry>
          <cylinder>
            <length>0.005</length>
            <radius>0.1</radius>
          </cylinder>
        </geometry>
        <surface>
          <contact>
            <ode/>
          </contact>
          <friction>
            <ode/>
          </friction>
        </surface>
      </collision>
      <visual name='rotor_left_visual'>
        <pose>0 0 0 0 -0 0</pose>
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>model://phoenixdrone/meshes/iris_prop_cw.dae</uri>
          </mesh>
        </geometry>
      </visual>
      <gravity>1</gravity>
      <velocity_decay/>
      <self_collide>0</self_collide>
    </link>
    <joint name='rotor_left_joint' type='revolute'>
      <child>rotor_left</child>
      <parent>base_link</parent>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e+16</lower>
          <upper>1e+16</upper>
        </limit>
        <dynamics>
          <spring_reference>0</spring_reference>
          <spring_stiffness>0</spring_stiffness>
        </dynamics>
      </axis>
    </joint>
    <link name='rotor_right'>
      <pose>0.0 0.195 0.4685 0 -0 0</pose>
      <inertial>
        <pose>0 0 0 0 -0 0</pose>
        <mass>0.005</mass>
        <inertia>
          <ixx>9.75e-07</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.000166704</iyy>
          <iyz>0</iyz>
          <izz>0.000167604</izz>
        </inertia>
      </inertial>
      <collision name='rotor_right_collision'>
        <pose>0 0 0 0 -0 0</pose>
        <geometry>
          <cylinder>
            <length>0.005</length>
            <radius>0.1</radius>
          </cylinder>
        </geometry>
        <surface>
          <contact>
            <ode/>
          </contact>
          <friction>
            <ode/>
          </friction>
        </surface>
      </collision>
      <visual name='rotor_right_visual'>
        <pose>0 0 0 0 -0 0</pose>
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>model://phoenixdrone/meshes/iris_prop_ccw.dae</uri>
          </mesh>
        </geometry>
      </visual>
      <gravity>1</gravity>
      <velocity_decay/>
      <self_collide>0</self_collide>
    </link>
    <joint name='rotor_right_joint' type='revolute'>
      <child>rotor_right</child>
      <parent>base_link</parent>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e+16</lower>
          <upper>1e+16</upper>
        </limit>
        <dynamics>
          <spring_reference>0</spring_reference>
          <spring_stiffness>0</spring_stiffness>
        </dynamics>
      </axis>
    </joint>
    <link name="left_elevon">
      <pose>0 0.195 0.2365 0 0 0</pose>
      <inertial>
        <mass>0.00000001</mass>
        <inertia>
          <ixx>0.000001</ixx>
          <ixy>0.0</ixy>
          <iyy>0.000001</iyy>
          <ixz>0.0</ixz>
          <iyz>0.0</iyz>
          <izz>0.000001</izz>
        </inertia>
      </inertial>
      <visual name="left_elevon_visual">
		<pose>0 0.0 0.0 0 0 0</pose>
		<geometry>
		  <box>
		    <size> 0.015 0.22 0.07347</size>
		  </box>
		</geometry>
      </visual>
    </link>
    <link name="right_elevon">
      <pose>0 -0.195 0.2365 0 0 0</pose>
      <inertial>
        <mass>0.00000001</mass>
        <inertia>
          <ixx>0.000001</ixx>
          <ixy>0.0</ixy>
          <iyy>0.000001</iyy>
          <ixz>0.0</ixz>
          <iyz>0.0</iyz>
          <izz>0.000001</izz>
        </inertia>
      </inertial>
     <visual name="left_elevon_visual">
		<pose>0 -0.0 0.0 0 0 0</pose>
		<geometry>
		  <box>
		    <size> 0.015  0.22 0.07347</size>
		  </box>
		</geometry>
     </visual>
    </link>
    <joint name='left_elevon_joint' type='revolute'>
      <parent>base_link</parent>
      <child>left_elevon</child>
      <pose>0 0.0 0.03 0.00 0 0.0</pose>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-1.0</lower>
          <upper>1.0</upper>
        </limit>
        <dynamics>
          <damping>1.000</damping>
        </dynamics>
      </axis>
    </joint>
    <joint name='right_elevon_joint' type='revolute'>
      <parent>base_link</parent>
      <child>right_elevon</child>
      <pose>0 0.0 0.03 0.00 0 0.0</pose>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-1.0</lower>
          <upper>1.0</upper>
        </limit>
        <dynamics>
          <damping>1.000</damping>
        </dynamics>
      </axis>
    </joint>
    <!-- Complete model-wide Tailsitter-control equations 5--14.  Parameters
         marked IDENTIFY are provisional defaults exposed for later fitting. -->
    <plugin name="phoenix::TailsitterAlphaAero" filename="libTailsitterAlphaAero.so">
      <rotor_velocity_slowdown>10</rotor_velocity_slowdown>
      <c_T>0.0000018</c_T>
      <c_mu>0.000000022</c_mu>
      <c_mu_T>-0.025</c_mu_T>
      <alpha_0>-0.03490658504</alpha_0> <!-- IDENTIFY: -2 deg -->
      <alpha_T>-0.0872664626</alpha_T>
      <c_LV>0.29</c_LV> <!-- IDENTIFY -->
      <c_DV>0.0</c_DV> <!-- IDENTIFY -->
      <c_LT>2.23</c_LT> <!-- IDENTIFY -->
      <c_DT>0.0</c_DT> <!-- IDENTIFY -->
      <c_LV_delta>0.18</c_LV_delta> <!-- IDENTIFY -->
      <c_LT_delta>1.25</c_LT_delta> <!-- IDENTIFY -->
      <l_Ty>0.15</l_Ty>
      <l_dy>0.12</l_dy>
      <l_dx>0.075</l_dx>
      <left_motor_number>0</left_motor_number>
      <right_motor_number>1</right_motor_number>
      <max_motor_speed>2500</max_motor_speed>
      <motor_time_constant>0.04</motor_time_constant>
      <!-- PX4, rotor joints, and alpha equations all exchange rad/s. -->
      <motor_input_scaling>1.0</motor_input_scaling>
      <motor_command_sub_topic>command/motor_speed</motor_command_sub_topic>
      <servo_time_constant>0.03</servo_time_constant>
      <servo_rate_limit>25.0</servo_rate_limit>
      <left_flap_limit>1.0</left_flap_limit>
      <right_flap_limit>1.0</right_flap_limit>
      <link_name>base_link</link_name>
      <!-- TS left/right after GZ FLU -> PX4 FRD -> TS conversion. -->
      <left_motor_joint_name>rotor_right_joint</left_motor_joint_name>
      <right_motor_joint_name>rotor_left_joint</right_motor_joint_name>
      <left_flap_joint_name>left_elevon_joint</left_flap_joint_name>
      <right_flap_joint_name>right_elevon_joint</right_flap_joint_name>
      <left_control_sub_topic>servo_1</left_control_sub_topic>
      <right_control_sub_topic>servo_0</right_control_sub_topic>
    </plugin>
    <plugin name="gz::sim::systems::MulticopterMotorModel" filename="gz-sim-multicopter-motor-model-system">
      <jointName>rotor_left_joint</jointName>
      <linkName>rotor_left</linkName>
      <turningDirection>cw</turningDirection>
      <timeConstantUp>0.040</timeConstantUp>
      <timeConstantDown>0.040</timeConstantDown>
      <maxRotVelocity>2500</maxRotVelocity>
      <!-- Joint-speed dynamics only. TailsitterAlphaAero applies all wrench. -->
      <motorConstant>0</motorConstant>
      <momentConstant>0</momentConstant>
      <commandSubTopic>command/motor_speed</commandSubTopic>
      <motorNumber>1</motorNumber>
      <rotorDragCoefficient>0</rotorDragCoefficient>
      <rollingMomentCoefficient>0</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
      <motorType>velocity</motorType>
    </plugin>
    <plugin name="gz::sim::systems::MulticopterMotorModel" filename="gz-sim-multicopter-motor-model-system">
      <jointName>rotor_right_joint</jointName>
      <linkName>rotor_right</linkName>
      <turningDirection>ccw</turningDirection>
      <timeConstantUp>0.040</timeConstantUp>
      <timeConstantDown>0.040</timeConstantDown>
      <maxRotVelocity>2500</maxRotVelocity>
      <!-- Joint-speed dynamics only. TailsitterAlphaAero applies all wrench. -->
      <motorConstant>0</motorConstant>
      <momentConstant>0</momentConstant>
      <commandSubTopic>command/motor_speed</commandSubTopic>
      <motorNumber>0</motorNumber>
      <rotorDragCoefficient>0</rotorDragCoefficient>
      <rollingMomentCoefficient>0</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
      <motorType>velocity</motorType>
    </plugin>
    <static>0</static>
  </model>
</sdf>
