<sdf version='1.10'>
  <model name='phoenixdrone'>
    <link name='base_link'>
      <pose>0 0 0.2 0 -0 0</pose>
      <inertial>
        <pose>0 0 0.157 0 -0 0</pose>
        <mass>0.5</mass>
        <inertia>
          <ixx>0.0147563</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.00638929</iyy>
          <iyz>0</iyz>
          <izz>0.0177</izz>
        </inertia>
      </inertial>
      <collision name='base_link_collision'>
        <pose>0 0 0 0 -0 0</pose>
        <geometry>
          <box>
            <size>0.2 0.6 0.06</size>
          </box>
        </geometry>
        <surface>
          <contact>
            <ode>
              <max_vel>10</max_vel>
              <min_depth>0.01</min_depth>
            </ode>
          </contact>
          <friction>
            <ode/>
          </friction>
        </surface>
      </collision>
      <visual name='base_link_visual'>
        <pose>0 0 0.27 0 -1.57075 0</pose>
        <geometry>
          <mesh>
            <scale>0.0006 0.0007 0.0007</scale>
            <uri>model://phoenixdrone/meshes/pacflyer_s100_mockup.dae</uri>
          </mesh>
        </geometry>
      </visual>
      <gravity>1</gravity>
      <velocity_decay/>
      <self_collide>0</self_collide>
      <!-- PX4 v1.16 gz_bridge uses fixed base_link sensor topic paths. -->
      <sensor name="imu_sensor" type="imu">
        <pose>0 0 0.157 0 0 0</pose>
        <always_on>1</always_on>
        <update_rate>500</update_rate>
        <imu>
          <angular_velocity>
            <x><noise type="gaussian"><stddev>0.0003394</stddev><dynamic_bias_stddev>3.8785e-05</dynamic_bias_stddev><dynamic_bias_correlation_time>1000</dynamic_bias_correlation_time></noise></x>
            <y><noise type="gaussian"><stddev>0.0003394</stddev><dynamic_bias_stddev>3.8785e-05</dynamic_bias_stddev><dynamic_bias_correlation_time>1000</dynamic_bias_correlation_time></noise></y>
            <z><noise type="gaussian"><stddev>0.0003394</stddev><dynamic_bias_stddev>3.8785e-05</dynamic_bias_stddev><dynamic_bias_correlation_time>1000</dynamic_bias_correlation_time></noise></z>
          </angular_velocity>
          <linear_acceleration>
            <x><noise type="gaussian"><stddev>0.004</stddev><dynamic_bias_stddev>0.006</dynamic_bias_stddev><dynamic_bias_correlation_time>300</dynamic_bias_correlation_time></noise></x>
            <y><noise type="gaussian"><stddev>0.004</stddev><dynamic_bias_stddev>0.006</dynamic_bias_stddev><dynamic_bias_correlation_time>300</dynamic_bias_correlation_time></noise></y>
            <z><noise type="gaussian"><stddev>0.004</stddev><dynamic_bias_stddev>0.006</dynamic_bias_stddev><dynamic_bias_correlation_time>300</dynamic_bias_correlation_time></noise></z>
          </linear_acceleration>
        </imu>
      </sensor>
      <sensor name="air_pressure_sensor" type="air_pressure"><always_on>1</always_on><update_rate>50</update_rate></sensor>
      <sensor name="magnetometer_sensor" type="magnetometer"><always_on>1</always_on><update_rate>100</update_rate></sensor>
      <sensor name="navsat_sensor" type="navsat"><always_on>1</always_on><update_rate>30</update_rate></sensor>
    </link>
    <link name='phoenixdrone/imu_link'>
      <pose>0 0 0.357 0 -0 0</pose>
      <inertial>
        <pose>0 0 0 0 -0 0</pose>
        <mass>0.015</mass>
        <inertia>
          <ixx>1e-05</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>1e-05</iyy>
          <iyz>0</iyz>
          <izz>1e-05</izz>
        </inertia>
      </inertial>
      <sensor name="imu_sensor" type="imu">
        <always_on>1</always_on>
        <update_rate>500</update_rate>
        <imu>
          <angular_velocity>
            <x><noise type="gaussian"><stddev>0.0003394</stddev><dynamic_bias_stddev>3.8785e-05</dynamic_bias_stddev><dynamic_bias_correlation_time>1000</dynamic_bias_correlation_time></noise></x>
            <y><noise type="gaussian"><stddev>0.0003394</stddev><dynamic_bias_stddev>3.8785e-05</dynamic_bias_stddev><dynamic_bias_correlation_time>1000</dynamic_bias_correlation_time></noise></y>
            <z><noise type="gaussian"><stddev>0.0003394</stddev><dynamic_bias_stddev>3.8785e-05</dynamic_bias_stddev><dynamic_bias_correlation_time>1000</dynamic_bias_correlation_time></noise></z>
          </angular_velocity>
          <linear_acceleration>
            <x><noise type="gaussian"><stddev>0.004</stddev><dynamic_bias_stddev>0.006</dynamic_bias_stddev><dynamic_bias_correlation_time>300</dynamic_bias_correlation_time></noise></x>
            <y><noise type="gaussian"><stddev>0.004</stddev><dynamic_bias_stddev>0.006</dynamic_bias_stddev><dynamic_bias_correlation_time>300</dynamic_bias_correlation_time></noise></y>
            <z><noise type="gaussian"><stddev>0.004</stddev><dynamic_bias_stddev>0.006</dynamic_bias_stddev><dynamic_bias_correlation_time>300</dynamic_bias_correlation_time></noise></z>
          </linear_acceleration>
        </imu>
      </sensor>
      <sensor name="air_pressure_sensor" type="air_pressure"><always_on>1</always_on><update_rate>50</update_rate></sensor>
      <sensor name="magnetometer_sensor" type="magnetometer"><always_on>1</always_on><update_rate>100</update_rate></sensor>
      <sensor name="navsat_sensor" type="navsat"><always_on>1</always_on><update_rate>30</update_rate></sensor>
    </link>
    <joint name='phoenixdrone/imu_joint' type='fixed'>
      <child>phoenixdrone/imu_link</child>
      <parent>base_link</parent>
    </joint>
    <!-- Harmonic replacement for the original measairspeedsim module. -->
    <include merge="true">
      <uri>model://airspeed</uri>
      <pose>0 0 0.55 0 -1.57079632679 0</pose>
    </include>
    <joint name='airspeed_joint' type='fixed'>
      <parent>base_link</parent>
      <child>airspeed_link</child>
    </joint>
    <link name='rotor_left'>
      <pose>0.0 -0.195 0.4685 0 -0 0</pose>
      <inertial>
        <pose>0 0 0 0 -0 0</pose>
        <mass>0.005</mass>
        <inertia>
          <ixx>9.75e-07</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.000166704</iyy>
          <iyz>0</iyz>
          <izz>0.000167604</izz>
        </inertia>
      </inertial>
      <collision name='rotor_left_collision'>
        <pose>0 0 0 0 -0 0</pose>
        <geometry>
          <cylinder>
            <length>0.005</length>
            <radius>0.1</radius>
          </cylinder>
        </geometry>
        <surface>
          <contact>
            <ode/>
          </contact>
          <friction>
            <ode/>
          </friction>
        </surface>
      </collision>
      <visual name='rotor_left_visual'>
        <pose>0 0 0 0 -0 0</pose>
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>model://phoenixdrone/meshes/iris_prop_cw.dae</uri>
          </mesh>
        </geometry>
      </visual>
      <gravity>1</gravity>
      <velocity_decay/>
      <self_collide>0</self_collide>
    </link>
    <joint name='rotor_left_joint' type='revolute'>
      <child>rotor_left</child>
      <parent>base_link</parent>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e+16</lower>
          <upper>1e+16</upper>
        </limit>
        <dynamics>
          <spring_reference>0</spring_reference>
          <spring_stiffness>0</spring_stiffness>
        </dynamics>
      </axis>
    </joint>
    <link name='rotor_right'>
      <pose>0.0 0.195 0.4685 0 -0 0</pose>
      <inertial>
        <pose>0 0 0 0 -0 0</pose>
        <mass>0.005</mass>
        <inertia>
          <ixx>9.75e-07</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.000166704</iyy>
          <iyz>0</iyz>
          <izz>0.000167604</izz>
        </inertia>
      </inertial>
      <collision name='rotor_right_collision'>
        <pose>0 0 0 0 -0 0</pose>
        <geometry>
          <cylinder>
            <length>0.005</length>
            <radius>0.1</radius>
          </cylinder>
        </geometry>
        <surface>
          <contact>
            <ode/>
          </contact>
          <friction>
            <ode/>
          </friction>
        </surface>
      </collision>
      <visual name='rotor_right_visual'>
        <pose>0 0 0 0 -0 0</pose>
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>model://phoenixdrone/meshes/iris_prop_ccw.dae</uri>
          </mesh>
        </geometry>
      </visual>
      <gravity>1</gravity>
      <velocity_decay/>
      <self_collide>0</self_collide>
    </link>
    <joint name='rotor_right_joint' type='revolute'>
      <child>rotor_right</child>
      <parent>base_link</parent>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e+16</lower>
          <upper>1e+16</upper>
        </limit>
        <dynamics>
          <spring_reference>0</spring_reference>
          <spring_stiffness>0</spring_stiffness>
        </dynamics>
      </axis>
    </joint>
    <link name="left_elevon">
      <pose>0 0.195 0.2365 0 0 0</pose>
      <inertial>
        <mass>0.00000001</mass>
        <inertia>
          <ixx>0.000001</ixx>
          <ixy>0.0</ixy>
          <iyy>0.000001</iyy>
          <ixz>0.0</ixz>
          <iyz>0.0</iyz>
          <izz>0.000001</izz>
        </inertia>
      </inertial>
      <visual name="left_elevon_visual">
		<pose>0 0.0 0.0 0 0 0</pose>
		<geometry>
		  <box>
		    <size> 0.015 0.22 0.07347</size>
		  </box>
		</geometry>
      </visual>
    </link>
    <link name="right_elevon">
      <pose>0 -0.195 0.2365 0 0 0</pose>
      <inertial>
        <mass>0.00000001</mass>
        <inertia>
          <ixx>0.000001</ixx>
          <ixy>0.0</ixy>
          <iyy>0.000001</iyy>
          <ixz>0.0</ixz>
          <iyz>0.0</iyz>
          <izz>0.000001</izz>
        </inertia>
      </inertial>
     <visual name="left_elevon_visual">
		<pose>0 -0.0 0.0 0 0 0</pose>
		<geometry>
		  <box>
		    <size> 0.015  0.22 0.07347</size>
		  </box>
		</geometry>
     </visual>
    </link>
    <joint name='left_elevon_joint' type='revolute'>
      <parent>base_link</parent>
      <child>left_elevon</child>
      <pose>0 0.0 0.03 0.00 0 0.0</pose>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <!-- -30/+30 deg. -->
          <lower>-1.05</lower>
          <upper>1.05</upper>
        </limit>
        <dynamics>
          <damping>1.000</damping>
        </dynamics>
      </axis>
    </joint>
    <joint name='right_elevon_joint' type='revolute'>
      <parent>base_link</parent>
      <child>right_elevon</child>
      <pose>0 0.0 0.03 0.00 0 0.0</pose>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <!-- -30/+30 deg. -->
          <lower>-0.53</lower>
          <upper>0.53</upper>
        </limit>
        <dynamics>
          <damping>1.000</damping>
        </dynamics>
      </axis>
    </joint>
    <plugin name="phoenix::PhoenixAero" filename="libPhoenixAero.so">
      <rotor_velocity_slowdown>10</rotor_velocity_slowdown>
      <k_lift>0.00000348</k_lift>
      <k_drag>0.00000175</k_drag>
      <k_pitch>-0.000000344</k_pitch>
      <cp>0 0.195 0.036</cp>
      <forward>0 0 1</forward>
      <upward>1 0 0</upward>
      <link_name>base_link</link_name>
      <motor_joint_name>rotor_left_joint</motor_joint_name>
      <control_sub_topic>servo_1</control_sub_topic>
      <control_joint_name>
        left_elevon_joint
      </control_joint_name>
    </plugin>
    <plugin name="phoenix::PhoenixAero" filename="libPhoenixAero.so">
      <rotor_velocity_slowdown>10</rotor_velocity_slowdown>
      <k_lift>0.00000348</k_lift>
      <k_drag>0.00000175</k_drag>
      <k_pitch>-0.000000344</k_pitch>
      <cp>0 -0.195 0.036</cp>
      <forward>0 0 1</forward>
      <upward>1 0 0</upward>
      <link_name>base_link</link_name>
      <motor_joint_name>rotor_right_joint</motor_joint_name>
      <control_sub_topic>servo_0</control_sub_topic>
      <control_joint_name>
        right_elevon_joint
      </control_joint_name>
    </plugin>
    <plugin name="gz::sim::systems::MulticopterMotorModel" filename="gz-sim-multicopter-motor-model-system">
      <jointName>rotor_left_joint</jointName>
      <linkName>rotor_left</linkName>
      <turningDirection>cw</turningDirection>
      <timeConstantUp>0.016</timeConstantUp>
      <timeConstantDown>0.020</timeConstantDown>
      <maxRotVelocity>800</maxRotVelocity>
      <motorConstant>7.864e-06</motorConstant>
      <momentConstant>0.023</momentConstant>
      <commandSubTopic>command/motor_speed</commandSubTopic>
      <motorNumber>1</motorNumber>
      <rotorDragCoefficient>0</rotorDragCoefficient>
      <rollingMomentCoefficient>0</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
      <motorType>velocity</motorType>
    </plugin>
    <plugin name="gz::sim::systems::MulticopterMotorModel" filename="gz-sim-multicopter-motor-model-system">
      <jointName>rotor_right_joint</jointName>
      <linkName>rotor_right</linkName>
      <turningDirection>ccw</turningDirection>
      <timeConstantUp>0.016</timeConstantUp>
      <timeConstantDown>0.020</timeConstantDown>
      <maxRotVelocity>800</maxRotVelocity>
      <motorConstant>7.864e-06</motorConstant>
      <momentConstant>0.023</momentConstant>
      <commandSubTopic>command/motor_speed</commandSubTopic>
      <motorNumber>0</motorNumber>
      <rotorDragCoefficient>0</rotorDragCoefficient>
      <rollingMomentCoefficient>0</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
      <motorType>velocity</motorType>
    </plugin>
    <static>0</static>
  </model>
</sdf>
