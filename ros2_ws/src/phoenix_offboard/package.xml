<?xml version="1.0"?>
<package format="3">
  <name>phoenix_offboard</name>
  <version>0.1.0</version>
  <description>ROS 2 Jazzy equivalents of PX4-PhoenixDrone offboard demos.</description>
  <maintainer email="dev@px4.io">PhoenixDrone port</maintainer>
  <license>BSD-3-Clause</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>px4_msgs</exec_depend>
